# -----------------------------------------------------------------------------
# Binaries and Compiled Artifacts
# -----------------------------------------------------------------------------
# Compiled applications (cross-platform binaries)
*.exe
*.exe~
*.dll
*.so
*.dylib

# Specific binary output directories (if you build to a /bin or /out folder)
bin/
out/

# Test binaries (generated by running 'go test -c')
*.test

# -----------------------------------------------------------------------------
# Tool and Coverage Artifacts
# -----------------------------------------------------------------------------
# Output of go tool cover (coverage profiles)
*.out
*.coverprofile
coverage.*
profile.cov

# -----------------------------------------------------------------------------
# Go Workspaces & Dependencies
# -----------------------------------------------------------------------------
# Go workspace files (used for local multi-module development)
go.work
go.work.sum

# Vendor directory
# NOTE: Only uncomment this if you explicitly choose NOT to commit dependencies.
# Most modern Go projects rely on mod caching instead of vendoring.
# vendor/

# -----------------------------------------------------------------------------
# Environment and Secrets
# -----------------------------------------------------------------------------
# Local environment variables containing secrets
.env
.env.local

# -----------------------------------------------------------------------------
# IDEs and Editors
# -----------------------------------------------------------------------------
# JetBrains (GoLand, IntelliJ)
.idea/
*.iml

# Visual Studio Code
.vscode/

# Operating System specific files
.DS_Store
Thumbs.db
